# Dependencies
node_modules/

# Build artifacts
# /copilot-api anchors the ignore to the repo-root binary; an unanchored
# pattern ("copilot-api") would also ignore the cmd/copilot-api/ source dir.
/copilot-api

# Local databases
*.db
*.db.bak
*.db.bak.*

# Environment files (may contain credentials)
.env
.env.*
!.env.example

# Vite
.vite/
dist/

# Embedded SPA build output — scripts/build.sh overwrites the placeholder in
# internal/webui/dist with the real Vite build; keep only the placeholder so
# //go:embed all:dist always compiles. The generic dist/ rule above would ignore
# this whole dir, so re-include the dir, ignore its contents, then keep index.html.
!internal/webui/dist/
internal/webui/dist/*
!internal/webui/dist/index.html

# OS
.DS_Store

# Playwright browser scratch (automated UI verification)
.playwright-mcp/

# Local Claude Code settings (machine-specific; not shared)
.claude/

# Ad-hoc screenshots / local visualization artifacts
incident-panorama-probe.png

# Capability validator generated reports
.capability-validation.json
validation-report.md

# Runtime artifacts created by scripts/*.sh (build + start stop/status/logs)
/bin/
/run/
/log/
/web/

# Rendered nginx config (generated from deploy/console-nginx.conf.template by scripts/nginx.sh)
/deploy/console-nginx.conf

# cas-test mock CAS runtime artifacts (generated by scripts/cas-test/start.sh & stop.sh)
scripts/cas-test/cas_server.log
scripts/cas-test/cas_server.pid
