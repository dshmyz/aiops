# AIOps Copilot - Production Configuration Template
#
# This file documents all available environment variables with production-ready defaults.
# Copy this to your deployment manifests (K8s ConfigMap/Secret, docker-compose env, etc.)
# and adjust values for your environment.
#
# SECURITY: Never commit actual secrets. Use a secret management system (Vault, K8s Secrets, etc.)

# ============================================================================
# Core Server
# ============================================================================

# HTTP server listen address
COPILOT_HTTP_ADDR: "0.0.0.0:18080"

# Log level: debug | info | warn | error
# Production: info or warn
COPILOT_LOG_LEVEL: "info"

# CORS allowed origins (comma-separated)
# Example: "https://console.example.com,https://admin.example.com"
COPILOT_CORS_ALLOWED_ORIGINS: "https://your-console-domain.com"

# ============================================================================
# Database
# ============================================================================

# Database driver: sqlite | mysql
# Production: mysql (SQLite is for dev/demo only)
COPILOT_DATABASE_DRIVER: "mysql"

# MySQL connection string
# Format: user:password@tcp(host:port)/dbname?parseTime=true&...
# Add connection pool params:
#   - maxAllowedPacket=67108864  (64MB for large audit logs)
#   - timeout=10s                (connection timeout)
#   - readTimeout=30s            (query read timeout)
#   - writeTimeout=30s           (query write timeout)
COPILOT_DATABASE_DSN: "copilot:YOUR_DB_PASSWORD@tcp(mysql-service:3306)/copilot?parseTime=true&maxAllowedPacket=67108864&timeout=10s&readTimeout=30s&writeTimeout=30s"

# Connection pool settings (set via DSN or Go sql.DB after opening)
# Recommended for production:
#   - db.SetMaxOpenConns(25)     # max concurrent connections
#   - db.SetMaxIdleConns(10)     # idle connections in pool
#   - db.SetConnMaxLifetime(5m)  # recycle connections every 5min

# ============================================================================
# Authentication & Authorization
# ============================================================================

# JWT HMAC secret for signing auth tokens
# CRITICAL: Generate with `openssl rand -base64 32`, never use "dev-secret"
COPILOT_JWT_HMAC_SECRET: "REPLACE_WITH_STRONG_RANDOM_SECRET_32_BYTES"

# Auth mode: jwt | cas | dev
# Production: jwt or cas
COPILOT_AUTH_MODE: "jwt"

# CAS (Central Authentication Service) settings (if COPILOT_AUTH_MODE=cas)
COPILOT_CAS_SERVER_URL: "https://cas.example.com"
COPILOT_CAS_SERVICE_URL: "https://copilot-api.example.com"

# ============================================================================
# Rate Limiting
# ============================================================================

# Rate limit per authenticated subject (user/service account)
# Format: "requests,window"
# Example: "100,1m" = 100 requests per minute per user
COPILOT_RATE_LIMIT_SUBJECT: "1000,1m"

# Rate limit per IP address (fallback for unauthenticated requests)
# Example: "50,1m" = 50 requests per minute per IP
COPILOT_RATE_LIMIT_IP: "200,1m"

# ============================================================================
# Capabilities (Tool Execution)
# ============================================================================

# Directory containing capability YAML definitions
# Production: mount this as a ConfigMap or persistent volume
COPILOT_CAPABILITIES_DIR: "/etc/copilot/capabilities"

# Mock middleware URL (for testing capabilities against a stub backend)
# Production: leave empty or point to staging middleware
COPILOT_MOCK_MIDDLEWARE_URL: ""

# ============================================================================
# MCP (Model Context Protocol) Servers
# ============================================================================

# JSON array of MCP server configurations
# Example: [{"name":"k8s","command":"mcp-kubernetes","args":["--kubeconfig=/root/.kube/config"],"env":{"NAMESPACE":"prod"}}]
# Production: Configure actual MCP servers for your infrastructure
COPILOT_MCP_SERVERS: '[]'

# ============================================================================
# Observability (OpenTelemetry)
# ============================================================================

# OTEL exporter: otlp | stdout | none
# Production: otlp
COPILOT_OTEL_EXPORTER: "otlp"

# OTLP collector endpoint
# Example: otel-collector:4318 (HTTP) or otel-collector:4317 (gRPC)
COPILOT_OTEL_OTLP_ENDPOINT: "http://otel-collector:4318"

# Trace sampling rate: 0.0 (none) to 1.0 (all)
# Production: 0.1 (10%) to reduce overhead, increase for debugging
# Set via code or OTEL_TRACES_SAMPLER env var
# OTEL_TRACES_SAMPLER: "traceidratio"
# OTEL_TRACES_SAMPLER_ARG: "0.1"

# ============================================================================
# Audit Logs
# ============================================================================

# Fallback audit log directory (if DB write fails)
# Production: enable and mount persistent storage
COPILOT_AUDIT_FALLBACK_ENABLED: "1"
COPILOT_AUDIT_FALLBACK_DIR: "/var/log/copilot/audit"

# ============================================================================
# Knowledge Base (RAG / Embeddings)
# ============================================================================

# Embedder API base URL (OpenAI-compatible)
# Example: https://api.openai.com/v1 or https://your-embedding-service/v1
COPILOT_KNOWLEDGE_EMBEDDER_BASE_URL: "https://api.openai.com/v1"

# Embedder API key
# CRITICAL: Use secret management, never commit
COPILOT_KNOWLEDGE_EMBEDDER_API_KEY: "sk-YOUR_OPENAI_OR_CUSTOM_KEY"

# Embedder model name
# OpenAI: text-embedding-3-small | text-embedding-3-large
COPILOT_KNOWLEDGE_EMBEDDER_MODEL: "text-embedding-3-small"

# ============================================================================
# Alert Ingestion
# ============================================================================

# Webhook secret for incoming alerts (Prometheus Alertmanager, etc.)
# Generate with `openssl rand -hex 32`
COPILOT_ALERT_WEBHOOK_SECRET: "REPLACE_WITH_WEBHOOK_SECRET"

# ============================================================================
# Notifications
# ============================================================================

# Feishu (Lark) webhook URL for sending notifications
# Leave empty to disable
COPILOT_FEISHU_WEBHOOK_URL: ""

# ============================================================================
# Development / Debugging Flags (DISABLE IN PRODUCTION)
# ============================================================================

# Expose confirmation token in plan detail API (for testing)
# Production: MUST be unset or "0"
# COPILOT_DEV_EXPOSE_CONFIRMATION_TOKEN: "0"

# ============================================================================
# Advanced Tuning
# ============================================================================

# Assistant planner concurrency
# Max number of concurrent LLM requests during action planning
# Production: 5-10 depending on LLM provider rate limits
# (Currently hardcoded, would need code change to expose as env var)

# HTTP client timeout for capability execution
# Production: 30s-60s depending on target systems
# (Currently uses http.DefaultClient, would need code change for custom timeout)

# Scheduled task executor concurrency
# Max number of tasks running simultaneously
# Production: 10-20 depending on workload
# (Currently may need code review to confirm if configurable)

# ============================================================================
# Kubernetes-specific Recommendations
# ============================================================================

# Resource requests/limits (set in Deployment manifest):
#   requests:
#     memory: 512Mi
#     cpu: 500m
#   limits:
#     memory: 2Gi
#     cpu: 2000m

# Readiness probe: GET /healthz (if implemented)
# Liveness probe: GET /healthz with longer timeout

# Pod anti-affinity: spread replicas across nodes for HA

# HPA (Horizontal Pod Autoscaler):
#   minReplicas: 2
#   maxReplicas: 10
#   targetCPUUtilizationPercentage: 70

# ============================================================================
# Security Checklist
# ============================================================================

# [ ] Rotate COPILOT_JWT_HMAC_SECRET regularly (every 90 days)
# [ ] Use K8s Secrets or Vault for COPILOT_DATABASE_DSN
# [ ] Enable TLS termination at ingress (use cert-manager)
# [ ] Network policies: only allow traffic from known sources
# [ ] Run as non-root user (set securityContext in K8s)
# [ ] Enable audit log fallback with persistent volume
# [ ] Set up log aggregation (Loki, Elasticsearch)
# [ ] Configure Prometheus scraping for /metrics (once implemented)
# [ ] Set up alerts for error rate, latency, and queue depth
