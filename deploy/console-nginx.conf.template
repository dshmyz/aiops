# capability-console — 宿主机 nginx 反代配置（模板）
#
# 由 scripts/nginx.sh 把 __WEB_DIR__ / __CONSOLE_PORT__ / __API_UPSTREAM__ 替换后渲染到
# deploy/console-nginx.conf。
#
# SPA 用相对 /v1 调后端，因此 nginx 同源托管静态文件并反代 /v1 -> copilot-api。
# 监听端口默认 8080（80 需 root 权限，可按需用 CONSOLE_PORT 覆盖）。

server {
    listen __CONSOLE_PORT__;
    server_name _;

    root __WEB_DIR__;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # 带 hash 的静态资源长缓存；index.html 不缓存以便发布后即时更新
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 同源反代到 copilot-api；SPA 自带 Authorization，仅透传
    location /v1/ {
        proxy_pass http://__API_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 300s;   # SSE 流式对话需要更长读超时
        proxy_buffering off;       # 关闭缓冲以便 SSE 实时推送
    }
}
