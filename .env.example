# Copilot API 配置示例
# 复制本文件为 .env 并填入真实值。.env 文件不会被提交到 git。
#
# 注意：服务本身不会自动加载 .env —— main.go 只读真实的环境变量。
# 启动前需手动导出（例如在项目根目录：source ./.env），
# 或通过外层进程 / Makefile 注入这些变量。

# ===== AI 助手（OpenAI 兼容接口）=====
# 留空或不设则使用确定性 planner，不调外部 LLM
# 注：设为 eino-openai 时，能力 OpenAPI 导入流程也会复用此 LLM 自动补参数中文说明/
# 示例/枚举（导入富化，v0.7.0+）。可用 `make dev-enrich` 检查是否配齐。
COPILOT_ASSISTANT_PROVIDER=eino-openai
# 自治 agent loop 的步数上限（默认 8）。多步循环需显式 opt-in 时才生效，见 docs/assistant.md
COPILOT_ASSISTANT_MAX_STEPS=8
COPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_OPENAI_API_KEY=sk-your-key-here
COPILOT_OPENAI_MODEL=gpt-4o
# 单次 LLM 调用超时（Go duration，如 30s / 60s）。推理型模型需要更长
COPILOT_OPENAI_TIMEOUT=90s
# 一次性补全失败时重试次数（>=1，默认 2；1 = 不重试）。连不上/等待响应头超时
# 这类瞬时故障会自动重试，避免抖动直接弹"请求失败"
COPILOT_OPENAI_RETRY=2
# 重试退避基值（Go duration，默认 500ms，指数递增至 8x）
COPILOT_OPENAI_RETRY_BACKOFF=500ms
# 单次补全最大 token 数（默认 2048）
COPILOT_OPENAI_MAX_TOKENS=2048

# ===== 模型分层路由（可选；不设则全部复用上面的主模型）=====
# 推理模型：agent 分析层深度推理用。三件套独立配一个更强的模型
COPILOT_REASONING_MODEL=
COPILOT_REASONING_BASE_URL=
COPILOT_REASONING_API_KEY=
# 备用模型：主模型限流/故障时自动降级
COPILOT_FALLBACK_MODEL=
COPILOT_FALLBACK_BASE_URL=
COPILOT_FALLBACK_API_KEY=
# 意图识别专用模型（可配小模型省钱）
COPILOT_INTENT_MODEL=
COPILOT_INTENT_BASE_URL=
COPILOT_INTENT_API_KEY=
# models.yaml 路径：显式指定后读取失败直接报错（不静默回退 env），与 RUNBOOKS_CONFIG 同原则
COPILOT_MODELS_CONFIG=

# ===== Agent 信任与预算 =====
# 信任等级：confirm（默认，写需人工确认）/ readonly（写工具一律拒绝）。
# 运行时也可在管理页调整，此处只定启动初值。未知值回落 confirm
COPILOT_AGENT_TRUST_LEVEL=confirm
# LLM 智能编排的控制步预算（默认 6）：规划类子任务的最大步数
COPILOT_AGENT_MAX_CONTROL_STEPS=6

# ===== 数据库 =====
# driver 支持 sqlite（默认）/ mysql
COPILOT_DATABASE_DRIVER=sqlite
# DSN 留空则用代码默认值（sqlite: file:copilot-local.db?cache=shared&_foreign_keys=on）
# 如需自定义：sqlite 用 "file:<路径>?cache=shared&_foreign_keys=on"，mysql 用标准 DSN
# COPILOT_DATABASE_DSN=
# 强制 MySQL：仅供 CI/集成测试用——置 1 后 DSN 为空直接报错，防止测试静默跑在 sqlite 上
# COPILOT_REQUIRE_MYSQL=0

# ===== HTTP 服务 =====
# 留空则使用默认端口（避开常见前端端口）
COPILOT_HTTP_ADDR=:8080
# CORS 允许的源（逗号分隔），留空则允许所有（*）。生产应设为前端域名
COPILOT_CORS_ALLOWED_ORIGINS=

# ===== 诊断桩数据源 =====
# 留空则使用内置硬编码桩数据；设为 mock 或真实中间件 API 地址后，
# staticReadRunner 会代理 HTTP GET 请求到该地址
COPILOT_MOCK_MIDDLEWARE_URL=

# ===== 能力目录 =====
# 留空则不启用能力管理
COPILOT_CAPABILITIES_DIR=

# 跳过 TLS 证书校验（对接自签/内网 HTTPS 后端）。开启后能力执行与 OpenAPI/Swagger
# 文档抓取都跳过证书校验（即信任所有端点）；生产默认关闭，开启前须自行评估风险。
COPILOT_OPENAPI_INSECURE_SKIP_VERIFY=0

# ===== 文档（后台"使用手册"）=====
# 指向 docs markdown 目录。留空则相对工作目录取 docs/；生产可在文档挂载到独立
# 只读卷时设绝对路径。仅 admin 可经 GET /v1/docs/{name} 读取，且限制在白名单文件内。
COPILOT_DOCS_DIR=

# ===== 认证 =====
# JWT HMAC 签名密钥（生产环境必须设置）
COPILOT_JWT_HMAC_SECRET=
# 开发模式：暴露确认 token（仅开发环境，生产禁用）
COPILOT_DEV_EXPOSE_CONFIRMATION_TOKEN=0
# 开发模式：未带认证头的 /v1 请求按固定 admin 身份执行（浏览器直连内嵌 SPA 用；仅开发，生产禁用）
COPILOT_DEV_INJECT_ADMIN=0

# ===== 自治（E2 自动执行）=====
# 让 AI 部分低风险写操作自动执行（不经人工确认）。三个自动执行源共用同一准入门：
# 直接对话低风险 runbook / agent loop 低风险写 / 定时触发低风险 runbook。
# 默认 fail-closed：0/未设 = 一切自动执行禁用（写仍走人工确认）；生产必须保持 0。
COPILOT_AUTONOMY_ENABLED=0
# 每个主体每日自动执行上限（防刷）。0 = 不限制（仅建议临时排查用）。默认 100。
COPILOT_AUTONOMY_DAILY_LIMIT=100
# 低风险自动执行工具白名单（逗号分隔，仅风险显式标 low 的写工具）。留空 = 不自动
# 执行任何工具。例：COPILOT_AUTONOMY_LOW_RISK_TOOLS=restart.service.soft
COPILOT_AUTONOMY_LOW_RISK_TOOLS=

# ===== 前端控制台（capability-console）=====
# 开发时代理注入的 admin JWT（vite.config.ts 读取，不要提交真实 token）
VITE_DEV_ADMIN_TOKEN=your-dev-admin-jwt-here
# Jaeger 基础地址，审计详情的"查看 Trace"链接会拼接 /trace/{trace_id}
# 留空则使用默认 http://localhost:16686
VITE_JAEGER_URL=http://localhost:16686

# ===== 可观测性（OTEL）=====
# 留空则不启用
COPILOT_OTEL_EXPORTER=
COPILOT_OTEL_OTLP_ENDPOINT=

# ===== 告警数据源（webhook 接入）=====
# 外部系统 POST /v1/alerts/webhook 推送告警，HMAC-SHA256 签名。
# 未设置则 webhook 路由返回 503（fail-closed，绝不接受未签名推送）。
COPILOT_ALERT_WEBHOOK_SECRET=

# ===== 告警智能处置（渐进自治，默认全关）=====
# LLM 智能研判（需 eino-openai 模式）；失败自动回退确定性 Diagnoser
COPILOT_ALERT_LLM_DIAGNOSE=0
# 告警接入后自动做链路诊断（确定性诊断器 + 诊断结果自动建 plan 等人工确认）
COPILOT_ALERT_AUTO_DIAGNOSE=0
# 告警→动作静态规则的 env 回退来源（JSON）；注册表（DB）已有规则时不生效。
# 仅 AUTO_PLAN=1 且后台规则为空时注入
COPILOT_ALERT_AUTO_PLAN=0
# COPILOT_ALERT_ACTIONS_JSON=[{"name":"重启服务","match":{"severity":"critical"},"tool":"restart.service.soft"}]

# ===== 日志 =====
# 日志级别：debug / info / warn / error
COPILOT_LOG_LEVEL=info
# 输出格式：json（默认，生产）/ console（开发，人类可读）
COPILOT_LOG_FORMAT=

# ===== 认证模式 =====
# jwt（默认）| cas | both
COPILOT_AUTH_MODE=jwt
# CAS SSO（COPILOT_AUTH_MODE=cas 或 both 时需要）
COPILOT_CAS_SERVER_URL=
COPILOT_CAS_SERVICE_URL=
# CAS 会话 cookie 有效期（Go duration，如 8h / 30m）。留空默认 8 小时
# COPILOT_CAS_SESSION_TTL=8h
# CAS 用户的默认角色（JSON 数组）。仅在 CAS 未下发 roles 属性时生效。
# 留空默认 ["operator"]。注意：默认不含 admin，admin 需由 CAS 下发 roles 属性。
# COPILOT_CAS_DEFAULT_ROLES=["operator"]
# CAS 用户的默认允许环境（JSON 数组）。留空默认 ["prod","staging","dev"]
# COPILOT_CAS_DEFAULT_ENVIRONMENTS=["prod","staging","dev"]
# CAS ticket 校验请求跳过 TLS 证书校验（自签 CAS 服务端用）。开启前自行评估风险
COPILOT_CAS_INSECURE_SKIP_VERIFY=0

# ===== 限流 =====
# 按调用方主体 / IP 的令牌桶容量与补充速率（每秒）
COPILOT_RATE_LIMIT_SUBJECT=
COPILOT_RATE_LIMIT_IP=

# ===== 外部 MCP 服务器（热配置）=====
# JSON 数组，启动时发现并注册 MCP 工具到统一工具表
# 例如：[{"name":"github","command":"mcp-server-github","args":[],"env":{"GITHUB_TOKEN":"x"}}]
COPILOT_MCP_SERVERS=

# ===== 内置 MCP server（把本系统能力作为 MCP 工具对外暴露）=====
# 开关 + 监听端口（默认 18081）+ Bearer token（留空则不鉴权，仅限内网试用）
COPILOT_MCP_SERVER_ENABLED=0
COPILOT_MCP_SERVER_PORT=18081
COPILOT_MCP_SERVER_TOKEN=

# ===== 主动健康巡检 =====
# Moonlight Box 健康端点基址；设置后 agent 健康检查器每 5 分钟探活一次
COPILOT_MOONLIGHTBOX_BASE_URL=

# ===== Prometheus 指标查询（prometheus.query 工具的数据源）=====
# 配置后 AI 助手可执行 PromQL 即时查询；留空时该工具如实返回 unconfigured。
COPILOT_PROMETHEUS_URL=

# ===== Runbook 诊断模板增量注册 =====
# runbooks.yaml 路径：同名覆盖内建模板、新名追加（"不改代码加模板"）。
# 文件缺失/损坏启动报错，不静默吞掉
# COPILOT_RUNBOOKS_CONFIG=

# ===== 通知 =====
# 飞书机器人 webhook，用于待确认动作通知；留空则仅日志通知
COPILOT_FEISHU_WEBHOOK_URL=

# ===== 审计兜底（防丢失）=====
# DB 写入失败时重试 + 本地 JSON 落盘 + 后台重放；默认开启
COPILOT_AUDIT_FALLBACK_ENABLED=1
COPILOT_AUDIT_FALLBACK_DIR=

# ===== 知识库（RAG 向量化）=====
# 配置后每次执行自动写入知识库文档供未来检索
COPILOT_KNOWLEDGE_EMBEDDER_BASE_URL=
COPILOT_KNOWLEDGE_EMBEDDER_API_KEY=
COPILOT_KNOWLEDGE_EMBEDDER_MODEL=

# ===== Prompt 注册表 =====
# 指向 prompt 模板目录（如 prompts/，内含 planning.md 等），支持热加载
COPILOT_PROMPTS_DIR=
