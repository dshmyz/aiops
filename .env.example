# Copilot API 配置示例
# 复制本文件为 .env 并填入真实值。.env 文件不会被提交到 git。
#
# 注意：服务本身不会自动加载 .env —— main.go 只读真实的环境变量。
# 启动前需手动导出（例如在项目根目录：source ./.env），
# 或通过外层进程 / Makefile 注入这些变量。

# ===== AI 助手（OpenAI 兼容接口）=====
# 留空或不设则使用确定性 planner，不调外部 LLM
COPILOT_ASSISTANT_PROVIDER=eino-openai
COPILOT_OPENAI_BASE_URL=https://api.openai.com/v1
COPILOT_OPENAI_API_KEY=sk-your-key-here
COPILOT_OPENAI_MODEL=gpt-4o
# 单次 LLM 调用超时（Go duration，如 30s / 60s）。推理型模型需要更长
COPILOT_OPENAI_TIMEOUT=60s

# ===== 数据库 =====
# driver 支持 sqlite（默认）/ mysql
COPILOT_DATABASE_DRIVER=sqlite
# DSN 留空则用代码默认值（sqlite: file:copilot-local.db?cache=shared&_foreign_keys=on）
# 如需自定义：sqlite 用 "file:<路径>?cache=shared&_foreign_keys=on"，mysql 用标准 DSN
# COPILOT_DATABASE_DSN=

# ===== HTTP 服务 =====
# 留空则使用默认端口（避开常见前端端口）
COPILOT_HTTP_ADDR=:8080
# CORS 允许的源（逗号分隔），留空则允许所有（*）。生产应设为前端域名
COPILOT_CORS_ALLOWED_ORIGINS=

# ===== 诊断桩数据源 =====
# 留空则使用内置硬编码桩数据；设为 mock 或真实中间件 API 地址后，
# staticReadRunner 会代理 HTTP GET 请求到该地址
COPILOT_MOCK_MIDDLEWARE_URL=

# ===== 能力目录 =====
# 留空则不启用能力管理
COPILOT_CAPABILITIES_DIR=

# ===== 认证 =====
# JWT HMAC 签名密钥（生产环境必须设置）
COPILOT_JWT_HMAC_SECRET=
# 开发模式：暴露确认 token（仅开发环境，生产禁用）
COPILOT_DEV_EXPOSE_CONFIRMATION_TOKEN=0

# ===== 前端控制台（capability-console）=====
# 开发时代理注入的 admin JWT（vite.config.ts 读取，不要提交真实 token）
VITE_DEV_ADMIN_TOKEN=your-dev-admin-jwt-here
# Jaeger 基础地址，审计详情的"查看 Trace"链接会拼接 /trace/{trace_id}
# 留空则使用默认 http://localhost:16686
VITE_JAEGER_URL=http://localhost:16686

# ===== 可观测性（OTEL）=====
# 留空则不启用
COPILOT_OTEL_EXPORTER=
COPILOT_OTEL_OTLP_ENDPOINT=

# ===== 告警数据源（webhook 接入）=====
# 外部系统 POST /v1/alerts/webhook 推送告警，HMAC-SHA256 签名。
# 未设置则 webhook 路由返回 503（fail-closed，绝不接受未签名推送）。
COPILOT_ALERT_WEBHOOK_SECRET=

# ===== 日志 =====
# 日志级别：debug / info / warn / error
COPILOT_LOG_LEVEL=info

# ===== 认证模式 =====
# jwt（默认）| cas | both
COPILOT_AUTH_MODE=jwt
# CAS SSO（COPILOT_AUTH_MODE=cas 或 both 时需要）
COPILOT_CAS_SERVER_URL=
COPILOT_CAS_SERVICE_URL=

# ===== 限流 =====
# 按调用方主体 / IP 的令牌桶容量与补充速率（每秒）
COPILOT_RATE_LIMIT_SUBJECT=
COPILOT_RATE_LIMIT_IP=

# ===== 外部 MCP 服务器（热配置）=====
# JSON 数组，启动时发现并注册 MCP 工具到统一工具表
# 例如：[{"name":"github","command":"mcp-server-github","args":[],"env":{"GITHUB_TOKEN":"x"}}]
COPILOT_MCP_SERVERS=

# ===== 通知 =====
# 飞书机器人 webhook，用于待确认动作通知；留空则仅日志通知
COPILOT_FEISHU_WEBHOOK_URL=

# ===== 审计兜底（防丢失）=====
# DB 写入失败时重试 + 本地 JSON 落盘 + 后台重放；默认开启
COPILOT_AUDIT_FALLBACK_ENABLED=1
COPILOT_AUDIT_FALLBACK_DIR=

# ===== 知识库（RAG 向量化）=====
# 配置后每次执行自动写入知识库文档供未来检索
COPILOT_KNOWLEDGE_EMBEDDER_BASE_URL=
COPILOT_KNOWLEDGE_EMBEDDER_API_KEY=
COPILOT_KNOWLEDGE_EMBEDDER_MODEL=

# ===== Prompt 注册表 =====
# 指向 prompt 模板目录（如 prompts/，内含 planning.md 等），支持热加载
COPILOT_PROMPTS_DIR=
